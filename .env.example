# Database connection settings for the opt-in SQL telemetry sink.
#
# A .env file that LionLock finds by itself (in the current directory or the repository root) is
# read for database connection settings only: LIONLOCK_DB_*, LIONLOCK_TELEMETRY_DB_*,
# LIONLOCK_WRITER_*, LIONLOCK_ADMIN_*, LIONLOCK_SSL*, LIONLOCK_TELEMETRY_SSL* and the SQL token
# variables. Anything else in it, including LIONLOCK_GATING_ENABLED, is ignored, so a .env in an
# untrusted checkout cannot switch gating off or redirect uploads.
#
# Gating is set in lionlock.toml ([gating] enabled = true|false), or by exporting
# LIONLOCK_GATING_ENABLED in the real environment of the process.
#
# The SQL sink stays off unless lionlock.toml sets [logging_sql] enabled = true.

# LIONLOCK_DB_HOST=
# LIONLOCK_DB_PORT=25060
# LIONLOCK_DB_NAME=lionlock_prod
# LIONLOCK_WRITER_USER=lionlock_writer
# LIONLOCK_WRITER_PASSWORD=
# LIONLOCK_SSLMODE=require
